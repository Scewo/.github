{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Scewo org-wide Renovate defaults",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommitsDisabled"
  ],
  "labels": ["dependencies"],
  "schedule": ["before 5am"],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,
  "rebaseWhen": "conflicted",
  "automerge": false,
  "packageRules": [
    {
      "description": "Org-wide: only manage scewo-messages sources, ignore everything else",
      "matchPackageNames": ["*"],
      "enabled": false
    },
    {
      "description": "Bundle all imx8-scewo-messages workspace crates into one PR per tag",
      "matchManagers": ["cargo"],
      "matchSourceUrls": ["https://github.com/Scewo/imx8-scewo-messages"],
      "enabled": true,
      "groupName": "imx8-scewo-messages",
      "commitMessageTopic": "imx8-scewo-messages",
      "commitMessagePrefix": "chore(deps):"
    },
    {
      "description": "Bundle all scewo-messages (bro) workspace crates into one PR per tag",
      "matchManagers": ["cargo"],
      "matchSourceUrls": ["https://github.com/Scewo/scewo-messages"],
      "enabled": true,
      "groupName": "scewo-messages",
      "commitMessageTopic": "scewo-messages",
      "commitMessagePrefix": "chore(deps):"
    }
  ]
}
