{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Scewo org-wide Renovate defaults",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommitsDisabled"
  ],
  "labels": ["dependencies"],
  "schedule": ["before 5am"],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,
  "rebaseWhen": "conflicted",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"]
  },
  "packageRules": [
    {
      "description": "Bundle all imx8-scewo-messages workspace crates into one PR per tag",
      "matchManagers": ["cargo"],
      "matchSourceUrls": ["https://github.com/Scewo/imx8-scewo-messages"],
      "groupName": "imx8-scewo-messages",
      "commitMessageTopic": "imx8-scewo-messages",
      "commitMessagePrefix": "chore(deps):"
    },
    {
      "description": "Bundle all scewo-messages (bro) workspace crates into one PR per tag",
      "matchManagers": ["cargo"],
      "matchSourceUrls": ["https://github.com/Scewo/scewo-messages"],
      "groupName": "scewo-messages",
      "commitMessageTopic": "scewo-messages",
      "commitMessagePrefix": "chore(deps):"
    },
    {
      "description": "Pre-1.0 minor bumps may be breaking; require human review",
      "matchManagers": ["cargo"],
      "matchCurrentVersion": "/^v?0\\./",
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false
    }
  ]
}
